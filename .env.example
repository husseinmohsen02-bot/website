# المنفذ اللي السيرفر هيشتغل عليه
PORT=3000

# باسورد لوحة الإدارة (/admin) — غيّره ضروري
ADMIN_PASSWORD=change-me

# اسم المتجر ورقم الواتساب بتاعك (بالصيغة الدولية بدون + أو أصفار، مثال مصر: 2010xxxxxxxx)
STORE_NAME=حَبّة بُن
STORE_NAME_EN=Habbet Bonn
STORE_WHATSAPP=971553626134

# مصاريف الشحن بالجنيه، والحد الأدنى للشحن المجاني (0 = مفيش شحن مجاني)
# مصاريف الشحن لكل محافظة في data/shipping.json — ده بيتطبق بس لو الملف مش موجود
SHIPPING_FEE=75
FREE_SHIPPING_OVER=0

# الطلب لو وزنه أكتر من كده (بالكيلو) بيظهر للعميل تنبيه إن ممكن يتضاف وزن زيادة
OVERWEIGHT_KG=1

# ---- اختياري: إرسال رسالة التأكيد تلقائياً عبر WhatsApp Cloud API (Meta) ----
# لو سبتهم فاضيين، العميل هيظهرله زرار يبعت تفاصيل الأوردر على واتساب المتجر.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# اسم قالب رسالة معتمد من Meta (مطلوب لإرسال أول رسالة للعميل)
# القالب يكون فيه 3 متغيرات: {{1}} اسم العميل، {{2}} رقم الأوردر، {{3}} الإجمالي
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=ar
